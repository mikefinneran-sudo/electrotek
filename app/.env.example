# Supabase (required for data modules)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo: open staff ERP API routes without auth (NEVER in production)
# BANANAFORCE_DEMO_OPEN_API=1

# Auth/signing secrets
# Required for token-gated portal, contract signing, and billing pay links.
AUTH_SECRET=
# Optional dedicated portal/ticket token secret; falls back to AUTH_SECRET when absent.
PORTAL_TOKEN_SECRET=

# Billing — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email notifications — Resend
RESEND_API_KEY=
ORDER_NOTIFY_TO=
ORDER_NOTIFY_FROM=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Lead-capture privacy
LEAD_CAPTURE_IP_HASH_SECRET=

# Inventory camera scanner (optional)
NEXT_PUBLIC_STRICH_LICENSE_KEY=

# Accounting — Tiller (default export path)
GOOGLE_SERVICE_ACCOUNT_JSON=
TILLER_SHEET_ID=
# TILLER_EXPORT_TAB=BananaFORCE Export

# Accounting — Wave (optional; Wave Pro required for OAuth)
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=
# WAVE_REDIRECT_URI=https://your-app.vercel.app/api/accounting/oauth/wave
# Required for Wave OAuth state signing.
WAVE_STATE_SIGNING_SECRET=
CONNECTOR_CREDENTIALS_KEY=

# Accounting — outbox drain (Vercel Cron uses CRON_SECRET or this)
ACCOUNTING_CRON_SECRET=
# CRON_SECRET=

# Rate limiting (optional) — distributed per-IP throttle for the lead form.
# When both are set, lead capture uses Upstash Redis across serverless instances;
# when unset it falls back to a best-effort in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
